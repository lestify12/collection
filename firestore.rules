rules_version = '2';

// Collection Tracker — Firestore security rules.
//
// V1: the app has no login yet, so reads and writes are open. This is
// acceptable only while the URL is private. Before sharing the site
// widely, enable Firebase Authentication and switch to the locked
// variant commented out below.
service cloud.firestore {
  match /databases/{database}/documents {

    match /app/{doc} {
      allow read: if true;
      allow write: if true;
    }

    match /records/{recordId} {
      allow read: if true;
      allow write: if true;
    }

    // --- Locked variant (use once Firebase Auth is enabled) ---
    // match /app/{doc} {
    //   allow read: if request.auth != null;
    //   allow write: if request.auth != null;
    // }
    // match /records/{recordId} {
    //   allow read: if request.auth != null;
    //   allow write: if request.auth != null;
    // }
  }
}
