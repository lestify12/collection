rules_version = '2';

// Collection Tracker — Firestore security rules (auth + assignment).
//
// Roles live in users/{uid}.role ("boss" | "agent"). Visibility of a
// record is driven by its `assignedTo` (a uid): the boss sees everything,
// an agent sees only records assigned to them. The client queries records
// with `where("assignedTo","==",uid)` for agents, which matches the read
// rule below so the query is allowed.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isBoss() {
      return hasProfile() && profile().role == 'boss';
    }
    // Manager (boss) + Team Leader (lead) both have full data access.
    function canViewAll() {
      return hasProfile() && (profile().role == 'boss' || profile().role == 'lead');
    }

    // User profiles. Manager reads/writes all; a Team Leader may read the
    // list (to assign work); everyone may read their own. Only the Manager
    // creates/changes accounts. A profile-less first sign-in may bootstrap
    // its own profile ONLY as a Collection Officer (never self-promote).
    match /users/{uid} {
      allow read:  if signedIn() && (request.auth.uid == uid || canViewAll());
      allow write: if isBoss()
        || (signedIn() && request.auth.uid == uid
            && !exists(/databases/$(database)/documents/users/$(uid))
            && request.resource.data.role == 'agent');
    }

    // App-level summary doc — any signed-in user may read; Manager writes.
    match /app/{doc} {
      allow read:  if signedIn();
      allow write: if isBoss();
    }

    // Unit records. Manager + Team Leader: full access (incl. assigning).
    // Collection Officer: read/update only their own assigned units, and
    // may not reassign a unit away from themselves.
    match /records/{recordId} {
      allow read:   if canViewAll() || (signedIn() && resource.data.assignedTo == request.auth.uid);
      allow update: if canViewAll()
        || (signedIn() && resource.data.assignedTo == request.auth.uid
            && request.resource.data.assignedTo == resource.data.assignedTo);
      allow create, delete: if canViewAll();
    }
  }
}
