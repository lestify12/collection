rules_version = '2';

// Collection Tracker — Firestore security rules (auth + assignment).
//
// Roles live in users/{uid}.role ("boss" | "agent"). Visibility of a
// record is driven by its `assignedTo` (a uid): the boss sees everything,
// an agent sees only records assigned to them. The client queries records
// with `where("assignedTo","==",uid)` for agents, which matches the read
// rule below so the query is allowed.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isBoss() {
      return hasProfile() && profile().role == 'boss';
    }

    // User profiles. A user can read their own; the boss reads/writes all.
    // The very first person to sign in may create their own boss profile
    // (bootstrap). After that, the boss creates every other account.
    match /users/{uid} {
      allow read:  if signedIn() && (request.auth.uid == uid || isBoss());
      allow write: if isBoss()
        || (signedIn() && request.auth.uid == uid
            && !exists(/databases/$(database)/documents/users/$(uid))
            && request.resource.data.role == 'boss');
    }

    // App-level summary doc — any signed-in user may read; boss writes.
    match /app/{doc} {
      allow read:  if signedIn();
      allow write: if isBoss();
    }

    // Unit records. Boss: full access. Agent: read/update only their own
    // assigned units, and may not reassign a unit away from themselves.
    match /records/{recordId} {
      allow read:   if isBoss() || (signedIn() && resource.data.assignedTo == request.auth.uid);
      allow update: if isBoss()
        || (signedIn() && resource.data.assignedTo == request.auth.uid
            && request.resource.data.assignedTo == resource.data.assignedTo);
      allow create, delete: if isBoss();
    }
  }
}
