rules_version = '2';

// Collection Tracker — Firestore security rules (auth + assignment).
//
// Roles live in users/{uid}.role: "boss" (Manager), "lead" (Collection TL),
// "agent" (Collection Officer). System/IT admins are matched by email.
// Reads: every signed-in user may read all records (officers see all
// projects). Writes: Manager + Team Leader may change anything; a Collection
// Officer may only update the units assigned to them (assignedTo == their uid).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // System/IT admins by email — always full Manager power. Keep this list
    // in sync with config.js `superAdmins`.
    function isAdmin() {
      return signedIn() && request.auth.token.email in ['admin@peacehomes.ae'];
    }
    // "Manager" powers = the boss role OR a system admin email.
    function isBoss() {
      return isAdmin() || (hasProfile() && profile().role == 'boss');
    }
    // Manager + Team Leader (lead) both have full data access.
    function canViewAll() {
      return isAdmin() || (hasProfile() && (profile().role == 'boss' || profile().role == 'lead'));
    }

    // User profiles. Manager reads/writes all; a Team Leader may read the
    // list (to assign work); everyone may read their own.
    //  - create: Manager creates anyone; a profile-less first sign-in may
    //    bootstrap its own profile ONLY as a Collection Officer.
    //  - update: Manager edits anyone; a user may edit their OWN profile
    //    (name, password-reset flag) but may NOT change their role or
    //    active status (no self-promotion).
    match /users/{uid} {
      allow read:   if signedIn() && (request.auth.uid == uid || canViewAll());
      allow create: if isBoss()
        || (signedIn() && request.auth.uid == uid && request.resource.data.role == 'agent');
      allow update: if isBoss()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.active == resource.data.active);
      allow delete: if isBoss();
    }

    // App-level summary doc — any signed-in user may read; Manager writes.
    match /app/{doc} {
      allow read:  if signedIn();
      allow write: if isBoss();
    }

    // Project-level assignments (records-independent) so a project with no
    // imported units yet can still be assigned. Any signed-in user reads
    // (officers need to see their assignment); Manager + Team Leader write.
    match /assignments/{doc} {
      allow read:  if signedIn();
      allow write: if canViewAll();
    }

    // Unit records. Everyone signed in may READ every record (officers see
    // all projects). Writing is restricted: Manager + Team Leader may change
    // anything; a Collection Officer may update only their own assigned units
    // (and not reassign a unit away from themselves). Create/delete stay with
    // Manager + Team Leader.
    match /records/{recordId} {
      allow read:   if signedIn();
      allow update: if canViewAll()
        || (signedIn() && resource.data.assignedTo == request.auth.uid
            && request.resource.data.assignedTo == resource.data.assignedTo);
      allow create, delete: if canViewAll();
    }
  }
}
